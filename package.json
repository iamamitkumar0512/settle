{
  "name": "settle",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Stablecoin invoicing on Whitechain: invoices, pay links, gasless payments and refunds in USDT.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @settle/web dev",
    "build": "pnpm --filter settle-pay build && pnpm --filter @settle/web build",
    "test:contracts": "cd contracts && forge test -vv"
  },
  "pnpm": {
    "overrides": {
      "@solana/kit": "8.6.0"
    }
  }
}
