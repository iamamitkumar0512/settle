{
  "name": "settle",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "The payment gateway for USDT on Whitechain: an app for invoices and subscriptions, and an SDK any website adds to accept payment.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @settle/web dev",
    "dev:store": "pnpm --filter chai-point dev",
    "build": "pnpm --filter @settle/web build",
    "build:store": "pnpm --filter chai-point build",
    "agent:wallet": "pnpm --filter restock-agent wallet",
    "agent:start": "pnpm --filter restock-agent start",
    "agent:check": "pnpm --filter restock-agent check",
    "test:contracts": "cd contracts && forge test -vv"
  },
  "pnpm": {
    "overrides": {
      "@solana/kit": "8.6.0"
    }
  }
}
