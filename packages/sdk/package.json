{
  "name": "@akhr2405/settle-pay",
  "version": "0.1.0",
  "description": "Take USDT on Whitechain the way you would take cards with a payment gateway: orders, checkout, verify, refunds. Your customer needs no wallet and no gas.",
  "license": "MIT",
  "homepage": "https://settle-usdt.vercel.app/docs",
  "bugs": "https://github.com/iamamitkumar0512/settle/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payments",
    "checkout",
    "usdt",
    "stablecoin",
    "whitechain",
    "gasless",
    "x402",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamamitkumar0512/settle.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/quickstart.ts"
  },
  "dependencies": {
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
