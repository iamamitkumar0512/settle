# Browser RPC. Optional: defaults to the public Whitechain RPC. Visitors can read this value, so
# never put a keyed address here.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.whitechain.io

# Server-only RPC for event reads. Never prefix this with NEXT_PUBLIC_.
RPC_ENDPOINT=

# Arkiv, server-only. Never prefix these with NEXT_PUBLIC_.
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# 64 hex characters, from: openssl rand -hex 32
ARKIV_DATA_KEY=

# For local tests only: lets webhooks reach localhost. Never set this on a deployed app.
WEBHOOK_ALLOW_LOCAL=

# Testnet demo: how much test USDT a new account can get, once a day, so it can try paying. It
# comes from the relayer wallet's USDT, so send some there. Off when empty.
DEMO_TOPUP_USDT=

# The sample store in apps/shop, once it is deployed. The landing page links to it.
NEXT_PUBLIC_DEMO_STORE_URL=

# Swarm, server-only, for PDF invoices: a Bee node or gateway, and the postage batch that pays
# for uploads. PDF upload is off until both are set.
SWARM_BEE_URL=
SWARM_BATCH_ID=

# Privy app ID, for customer email login. Safe to expose.
PRIVY_APP_ID=

# Relayer, server-only. A wallet used for nothing else, holding a little WBT.
RELAYER_PK=
# Email reminders, server-only. Off until the key is set. Without a domain verified in Resend,
# leave REMINDER_FROM out: Resend's own sender then delivers only to your Resend account's address.
RESEND_API_KEY=
# REMINDER_FROM=Settle <billing@your-domain.example>
# The app's public address, for links in emails. Defaults to the address a request came to.
# APP_URL=https://your-app.example

# Optional. When set, the /api/cron routes only answer a caller that sends it as a bearer token.
# Vercel Cron sends it by itself.
# CRON_SECRET=

# Optional relayer settings, with their defaults.
# RELAY_FEE_USDT=0.05
# WITHDRAW_FEE_USDT=0.05
# MIN_INVOICE_USDT=1
# RELAYER_MAX_FEE_GWEI=50
# RELAYER_MIN_WBT=0.005
# RELAYER_FREE_PER_DAY=500
