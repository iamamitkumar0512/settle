# Browser RPC. Optional: defaults to the public Whitechain RPC.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.whitechain.io

# Server-only RPC for event reads. Never prefix this with NEXT_PUBLIC_.
RPC_ENDPOINT=

# Arkiv, server-only. Never prefix these with NEXT_PUBLIC_.
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# 64 hex characters, from: openssl rand -hex 32
ARKIV_DATA_KEY=
