# Make the wallet with `pnpm agent:wallet`. It writes AGENT_KEY here and prints the address to fund.
# It needs test USDT and no WBT.
AGENT_KEY=

# The store it buys from, and that store's Settle Key ID. The agent refuses to pay anyone else.
STORE_URL=http://localhost:3100
STORE_ADDRESS=

# The most it may pay in one go. Its total budget is whatever its wallet holds.
MAX_PER_PAYMENT=5.00

# For `pnpm agent:check`: where Settle runs.
SETTLE_URL=http://localhost:3000

# For `pnpm agent:start`, the AI that decides what to buy. Get one at aistudio.google.com/apikey.
GEMINI_API_KEY=

# Only for a local fork of the chain.
# AGENT_RPC_URL=http://127.0.0.1:8545
